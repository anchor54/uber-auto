{
  "name": "commute-backend",
  "version": "1.0.0",
  "description": "Backend for the commute rider and driver apps",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "sim": "tsx src/sim_cli.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "start:prod": "node dist/server.js",
    "worker:prod": "node dist/worker.js",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:config": "tsx src/db/seed_config.ts",
    "seed:config:prod": "node dist/db/seed_config.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
